# NukeViet 5.x Docker Environment

# Application
APP_ENV=development
APP_DEBUG=true

# Database
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nukeviet5
DB_USERNAME=nukeviet
DB_PASSWORD=nukeviet_password
DB_ROOT_PASSWORD=password

# Redis (for workers/queue)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Web Server
WEB_PORT=80
WEB_SSL_PORT=443
PHPMYADMIN_PORT=8001
REDIS_COMMANDER_PORT=8002
